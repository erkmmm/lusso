#!/bin/sh
#
# Stop a push to main from silently un-deploying live features.
#
# This repo has two paths to the same production site and they disagree about
# what "the app" is:
#
#   git push main      → Cloudflare builds FROM THE COMMIT. Uncommitted work
#                        does not exist as far as that build is concerned.
#   npm run deploy     → uploads a build of the WORKING TREE, uncommitted work
#                        included. version.json's sha gets a "+".
#
# Features have lived uncommitted in this tree for days at a time while being
# live via the second path. A push to main then replaces live with a build that
# never had them — no error, no warning, the page is just gone. It has happened:
# the /growth page went off live on 2026-11-04 that way.
#
# So: a push to main is refused while source files that shape the bundle are
# uncommitted. Commit them (a commit is not a deploy — only a push is) or say
# explicitly that you mean it.
#
# Install:  git config core.hooksPath .githooks   (or copy to .git/hooks/pre-push)
# Override: LUSSO_ALLOW_DIRTY_PUSH=1 git push ...

[ -n "$LUSSO_ALLOW_DIRTY_PUSH" ] && exit 0

# Does this push touch main at all? Nothing else deploys, so nothing else is
# guarded — feature branches push freely.
pushes_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) pushes_main=1 ;;
  esac
done
[ "$pushes_main" -eq 1 ] || exit 0

# What actually ends up in the bundle. supabase/ and ops/ are deployed by other
# means and are deliberately not counted here.
paths='src public index.html vite.config.js package.json package-lock.json'

dirty=$(git status --porcelain -- $paths | grep -v '^ M public/version\.json$')

[ -z "$dirty" ] && exit 0

printf '\n\033[1;31m✗ Push to main refused — it would drop uncommitted work off the live site.\033[0m\n\n'
printf 'Cloudflare builds main FROM THE COMMIT. These files are not in it, so the\n'
printf 'build this push triggers will not contain them — and if the live site is\n'
printf 'currently serving them (a "+" on the sha in version.json), they disappear:\n\n'
printf '%s\n' "$dirty" | sed 's/^/    /'
printf '\n\033[1mPick one:\033[0m\n'
printf '  • Commit them, then push       — the Git build is then complete and correct\n'
printf '  • Commit them on a branch      — a commit is not a deploy; only a push to main is\n'
printf '  • LUSSO_ALLOW_DIRTY_PUSH=1 git push …   — you know live loses the above\n\n'
printf 'Check what live is serving right now:  npm run deploy:status\n\n'
exit 1
