# Supabase — the only values the browser bundle sees.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email, for `npm run dev`. The Cloudflare Pages Functions read these
# server-side; they are never bundled into the client.
#
# Keep EMAIL_FROM matching production. Left as Resend's shared sandbox address
# (onboarding@resend.dev) it only delivers to your own Resend account address,
# which reads exactly like "email is broken".
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Lusso <jobs@lusso.com.au>
