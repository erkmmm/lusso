# Supabase — the only values the browser bundle sees.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email, for `npm run dev`. The Cloudflare Pages Functions read these
# server-side; they are never bundled into the client.
#
# Keep EMAIL_FROM matching production. Left as Resend's shared sandbox address
# (onboarding@resend.dev) it only delivers to your own Resend account address,
# which reads exactly like "email is broken".
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Lusso <jobs@lusso.com.au>

# Cloudflare Turnstile site key for the login / signup / password-reset forms.
# Supabase verifies the token (Dashboard → Authentication → Attack Protection
# → CAPTCHA), which is where the *secret* key goes — never here, this file is
# bundled into the browser. Leave it unset and the widget is skipped entirely.
# 1x00000000000000000000AA is Cloudflare's always-passes test key for local dev.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
