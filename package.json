{
  "name": "lusso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.js && node scripts/generate-icons.js && node scripts/stamp-version.js && vite build",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=lusso --commit-dirty=true",
    "postdeploy": "sh scripts/deploy-status.sh",
    "deploy:status": "sh scripts/deploy-status.sh",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-push guard active'",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:security": "node --experimental-vm-modules scripts/security.test.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.77",
    "@supabase/supabase-js": "^2.105.3",
    "date-fns": "^4.1.0",
    "dompurify": "3.4.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.14.0",
    "lz-string": "^1.5.0",
    "motion": "^12.40.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.17"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
